<Window x:Class="MiniDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiniDashboard.App.ViewModels"
        xmlns:behaviors="clr-namespace:MiniDashboard.App.Behaviors"
        xmlns:c="clr-namespace:MiniDashboard.App.Helpers"
        Title="MiniDashboard" Height="500" Width="850"
        Background="#FAFAFA">

    <Window.DataContext>
        <vm:ItemsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <c:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel Margin="20">

        <!-- Top filter bar -->
        <Border DockPanel.Dock="Top" 
        Background="#F2F2F2" 
        Padding="10"
        Margin="0,0,0,15">
            <StackPanel>
                <!-- Category selector -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Label Content="Category:" 
                   FontWeight="SemiBold" 
                   VerticalAlignment="Center" 
                   Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Datasets}"
                      SelectedItem="{Binding SelectedDataset}"
                      Width="200"
                      VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Content="Search:" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" 
                   Margin="0,0,5,0"/>
                    <TextBox Width="250" 
                     Height="28"
                     Padding="5,2"
                     Background="White"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>


        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Status messages -->
            </Grid.RowDefinitions>

            <!-- 📋 DataGrid Section -->
            <Border Grid.Row="0"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Background="White"
            Padding="10"
            Margin="0,0,0,10">
                <Grid HorizontalAlignment="Center">
                    <DataGrid ItemsSource="{Binding ItemsView}" 
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#F9F9F9"
                      GridLinesVisibility="Horizontal"
                      MaxWidth="900" 
                      MinWidth="600"
                      MinHeight="200"
                      behaviors:DataGridAutoColumnsBehavior.AutoColumns="True"/>
                </Grid>
            </Border>

            <!-- 🔘 Buttons Section -->
            <Border Grid.Row="1"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Background="White"
            Padding="10"
            Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0">

                    <Button Content="Add" 
                    Command="{Binding AddItemCommand}" 
                    Width="90" Height="32"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="#006BB3"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="5,0"
                    Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <Button Content="Update" 
                    Command="{Binding UpdateItemCommand}" 
                    behaviors:DataGridCommitBehavior.CommitEditsOnClick="True"
                    Width="90" Height="32"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="#006BB3"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="5,0"
                    Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <Button Content="Delete" 
                    Command="{Binding DeleteItemCommand}" 
                    behaviors:DataGridCommitBehavior.CommitEditsOnClick="True"
                    Width="90" Height="32"
                    Background="#D9534F"
                    Foreground="White"
                    BorderBrush="#C9302C"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="5,0"
                    Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"/>
                </StackPanel>
            </Border>

            <!-- 💬 Status Section -->
            <Border Grid.Row="2"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Background="White"
            Padding="8"
            Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0">

                    <!-- Loading indicator -->
                    <TextBlock Text="Loading..."
                       Foreground="Gray"
                       FontStyle="Italic"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,0,10,0"/>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                       Margin="0,0,10,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
